  "key_decisions": {
    "architecture": "Edge-server model: Pi devices extract locally, POST lightweight JSON (~1KB) to server instead of streaming video",
    "database": "SQLite for MVP (easy setup, file-based), PostgreSQL for production",
    "vector_store": "Qdrant for semantic search, fallback to in-memory L1 distance",
    "matching_algorithm": "Weighted sum of 4 similarity signals (visual, audio, OCR, logo) with configurable weights and threshold",
    "async_matching": "Captures ingest immediately (return 200), matching happens asynchronously in background task",
    "fingerprint_keying": "Use external_content_id (string) not id (int) for flexible content ingestion"
  },

  "notes": {
    "critical_bug_fixed": "Library seeding was checking 'if any items exist' → 'if all defaults exist'. This caused tests to fail with stale data.",
    "test_requirement": "Always run 'pytest -v' after changes to regression-test the system",
    "database_persistence": "SQLite persists across sessions (good for production, requires careful seeding for tests)",
    "vector_store_fallback": "Currently uses in-memory L1 distance. Qdrant not deployed yet.",
    "production_ready_for": "Single device testing, matching algorithm validation, API stability",
    "production_not_ready_for": "1000+ device scale, real hardware extraction, production analytics"
  }
}
